# Copy this file to .env and fill in your real values (never commit .env to GitHub)

# Supabase Project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Project Settings -> API -> service_role secret)
# Keep this strictly on the backend — never expose it in frontend HTML/JS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Storage bucket name (must match the bucket created in supabase_schema.sql)
SUPABASE_BUCKET=portfolio-media

# Fallback Admin Passcode (used on first boot if not yet set in DB)
ADMIN_PASSCODE=kaula12
